[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="responsive_example_main.gd" id="1_main"]
[ext_resource type="PackedScene" path="../../src/responsive_layout.tscn" id="2_layout"]
[ext_resource type="Resource" path="../../presets/app_shell_layout_config.tres" id="3_config"]
[ext_resource type="Script" path="../../src/responsive_flex.gd" id="4_flex"]
[ext_resource type="Script" path="../../src/responsive_flex_item.gd" id="5_flex_item"]
[ext_resource type="Script" path="../../src/responsive_grid.gd" id="6_grid"]
[ext_resource type="Script" path="../../src/responsive_grid_item.gd" id="7_grid_item"]

[node name="ResponsiveExampleMain" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="ResponsiveLayout" parent="." instance=ExtResource("2_layout")]
layout_config = ExtResource("3_config")
editor_preview_enabled = true

[node name="Header" type="VBoxContainer" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/Header"]
layout_mode = 2
text = "Responsive App Shell"
horizontal_alignment = 1

[node name="ViewportLabel" type="Label" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/Header"]
layout_mode = 2
text = "Viewport: preview"
horizontal_alignment = 1

[node name="Actions" type="Container" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer"]
layout_mode = 2
script = ExtResource("4_flex")
direction = 0
justify_content = 1
align_items = 3
gap = 12.0
wrap = true
direction_breakpoints = {
0: 1,
640: 0
}

[node name="PrimaryAction" type="Control" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/Actions"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
script = ExtResource("5_flex_item")
flex_grow = 1

[node name="Button" type="Button" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/Actions/PrimaryAction"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
text = "Primary"

[node name="SecondaryAction" type="Button" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/Actions"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
text = "Secondary"

[node name="FeatureGrid" type="Container" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer"]
layout_mode = 2
script = ExtResource("6_grid")
columns = 0
min_column_width = 180.0
column_gap = 16.0
row_gap = 16.0
columns_breakpoints = {
0: 1,
700: 2,
1000: 3
}

[node name="FeatureA" type="PanelContainer" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/FeatureGrid"]
custom_minimum_size = Vector2(180, 96)
layout_mode = 2

[node name="FeatureALabel" type="Label" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/FeatureGrid/FeatureA"]
layout_mode = 2
text = "Compact card"
horizontal_alignment = 1
vertical_alignment = 1

[node name="FeatureB" type="Control" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/FeatureGrid"]
custom_minimum_size = Vector2(180, 96)
layout_mode = 2
script = ExtResource("7_grid_item")
column_span = 1

[node name="Panel" type="PanelContainer" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/FeatureGrid/FeatureB"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="FeatureBLabel" type="Label" parent="ResponsiveLayout/ScrollContainer/MarginContainer/CenterContainer/VBoxContainer/FeatureGrid/FeatureB/Panel"]
layout_mode = 2
text = "Responsive card"
horizontal_alignment = 1
vertical_alignment = 1
